<?xml version="1.0" encoding="utf-8"?>

<!-- The line below is required in order to use the multibuild OBS features -->
<!-- OBS-Profiles: @BUILD_FLAVOR@ -->

<image schemaversion="7.5" name="boxbuild">
    <description type="system">
        <author>Marcus Schäfer</author>
        <contact>marcus.schaefer@gmail.com</contact>
        <specification>kiwi runtime container</specification>
    </description>
    <profiles>
        <profile name="OCI" description="Runtime for Linux"/>
        <profile name="WSL" description="Runtime for Windows"/>
    </profiles>
    <preferences>
        <version>1.1.0</version>
        <packagemanager>zypper</packagemanager>
        <rpm-excludedocs>true</rpm-excludedocs>
        <rpm-check-signatures>false</rpm-check-signatures>
        <locale>en_US</locale>
        <keytable>us</keytable>
    </preferences>
    <preferences profiles="OCI">
        <type image="docker">
            <containerconfig name="boxbuild" tag="latest">
                <entrypoint execute="/usr/bin/kiwi-ng"/>
            </containerconfig>
        </type>
    </preferences>
    <preferences profiles="WSL">
        <type image="wsl"/>
    </preferences>
    <users>
        <user password="$1$wYJUgpM5$RXMMeASDc035eX.NbYWFl0" home="/root" name="root" groups="root"/>
    </users>
    <repository type="rpm-md">
        <source path="obsrepositories:/"/>
    </repository>
    <packages type="image">
        <package name="python3-kiwi"/>
        <package name="kiwi-systemdeps-boxbuild"/>
        <!-- recommended by kiwi-systemdeps-boxbuild, required for
             the virtiofs sharing backend of kiwi-boxbuild -->
        <package name="virtiofsd"/>
    </packages>
    <packages type="bootstrap">
        <package name="gawk"/>
        <package name="grep"/>
        <package name="gzip"/>
        <package name="udev"/>
        <package name="xz"/>
        <package name="shadow"/>
        <package name="filesystem"/>
        <package name="glibc-locale"/>
        <package name="cracklib-dict-full"/>
        <package name="ca-certificates"/>
        <package name="ca-certificates-mozilla"/>
    </packages>
</image>
