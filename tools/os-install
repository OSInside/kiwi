#!/bin/bash
# KIWI install image activation from isofile
#
# Usage:
#   os-install --kiwi-install-iso /path/to/some.install.iso
#       Install this script as grub2-mkconfig generator to
#       /etc/grub.d/99_os_install. The generator creates a grub
#       menu entry which loopback boots the given install ISO.
#       grub2-mkconfig must be called afterwards to make it effective.
#
#   os-install --kiwi-install-iso /path/to/some.install.iso --kexec
#       Extract kernel and initrd from the install ISO and
#       immediately boot into it via kexec.
#
#   os-install --kiwi-install-iso /path/to/some.install.iso --grub-menu-entry
#       Print the grub menu entry for the install ISO. This is what
#       /etc/grub.d/99_os_install runs when called by grub2-mkconfig.
#       The installed generator is a copy of this script whose final
#       main call passes these options.

grub_generator=/etc/grub.d/99_os_install

ARCH=$(uname -m)

# location of kernel and initrd inside of a KIWI install ISO
iso_kernel="/boot/${ARCH}/loader/linux"
iso_initrd="/boot/${ARCH}/loader/initrd"

# volume label used by kiwi if the ISO does not provide one
default_install_label=INSTALL

tmp_dir=

usage() {
    cat <<EOF
Usage:
  os-install --kiwi-install-iso /path/to/some.install.iso
      Install as grub generator ${grub_generator}

  os-install --kiwi-install-iso /path/to/some.install.iso --kexec
      Immediately boot into the install ISO via kexec

  os-install --kiwi-install-iso /path/to/some.install.iso --grub-menu-entry
      Print grub menu entry for the install ISO (used by grub2-mkconfig)
EOF
}

die() {
    echo "os-install: error: $*" >&2
    exit 1
}

warn() {
    echo "os-install: warning: $*" >&2
}

cleanup() {
    if [[ -n "${tmp_dir}" ]] && [[ -d "${tmp_dir}" ]]; then
        if mountpoint -q "${tmp_dir}/iso" 2>/dev/null; then
            umount "${tmp_dir}/iso"
        fi
        rm -rf "${tmp_dir}"
    fi
}

require_root() {
    [[ "${EUID}" -eq 0 ]] || die "must be called as root"
}

read_file_bytes() {
    # Print count bytes at the given offset of a file. NUL bytes
    # are dropped by bash read, a short read at EOF is not an error
    local file=$1
    local offset=$2
    local count=$3
    local data=
    LC_ALL=C read -r -N "${count}" data < <(
        dd if="${file}" bs=1 skip="${offset}" count="${count}" 2>/dev/null
    ) || true
    printf '%s' "${data}"
}

is_iso9660_file() {
    # ISO9660 primary volume descriptor starts at sector 16 (2048 bytes
    # per sector) and carries the standard identifier "CD001" at offset 1
    local iso_file=$1
    local signature
    [[ -f "${iso_file}" ]] || return 1
    signature=$(read_file_bytes "${iso_file}" 32769 5)
    [[ "${signature}" = "CD001" ]]
}

get_iso_volume_label() {
    # Read the volume identifier from the ISO9660 primary volume
    # descriptor, kiwi uses it as CDLABEL=... to find the install media
    local iso_file=$1
    local label
    label=$(read_file_bytes "${iso_file}" 32808 32)
    # strip trailing padding
    label="${label%"${label##*[![:space:]]}"}"
    echo "${label:-${default_install_label}}"
}

get_install_boot_options() {
    # boot options needed for install
    local iso_file=$1
    local label
    label=$(get_iso_volume_label "${iso_file}")
    echo "cdinst=1 root=install:CDLABEL=${label}"
}

get_iso_path_on_device() {
    # Print the path of the ISO file relative to the root of the
    # filesystem as it gets mounted by default. This is the path
    # dracut's iso-scan looks up on the devices and, on SUSE systems
    # with btrfs_relative_path enabled, also the path grub uses
    local iso_file=$1
    local source
    local mount_point
    local fs_type
    local fs_root
    local default_subvol
    local path
    source=$(findmnt -n -v -o SOURCE --target "${iso_file}")
    mount_point=$(findmnt -n -o TARGET --target "${iso_file}")
    fs_type=$(findmnt -n -o FSTYPE --target "${iso_file}")
    fs_root=$(findmnt -n -o FSROOT --target "${iso_file}")
    case "${source}" in
        /dev/*) ;;
        *)
            echo "${iso_file} is not stored on a local block device" >&2
            return 1
        ;;
    esac
    # path below the mount point
    path="${iso_file#"${mount_point%/}"}"
    # path below the filesystem root for bind mounts and subvolumes
    fs_root="${fs_root%/}"
    path="${fs_root}${path}"
    if [[ "${fs_type}" = "btrfs" ]]; then
        # btrfs is mounted with the default subvolume if no
        # subvol= option is given, make the path relative to it
        if ! default_subvol=$(
            btrfs subvolume get-default "${mount_point}" 2>/dev/null
        ); then
            echo "failed to read btrfs default subvolume" >&2
            return 1
        fi
        # top level subvolume prints as: ID 5 (FS_TREE), other
        # subvolumes as: ID 268 gen 2056 top level 267 path @/...
        if [[ "${default_subvol}" == *" path "* ]]; then
            default_subvol="${default_subvol##* path }"
        else
            default_subvol=
        fi
        if [[ -n "${default_subvol}" ]]; then
            case "${path}" in
                "/${default_subvol}"/*)
                    path="${path#"/${default_subvol}"}"
                ;;
                *)
                    echo "${iso_file} is on btrfs subvolume ${fs_root}" \
                        "which is not part of the default subvolume" \
                        "/${default_subvol}. Please store the ISO file" \
                        "in a directory of the root subvolume" >&2
                    return 1
                ;;
            esac
        fi
    fi
    echo "${path}"
}

check_iso_file_name() {
    # The ISO path ends up in grub config and on the kernel command
    # line, only allow characters which need no quoting there
    local iso_file=$1
    if ! [[ "${iso_file}" =~ ^/[A-Za-z0-9._/+,@:=-]+$ ]]; then
        die "unsupported characters in ISO file path: ${iso_file}"
    fi
}

check_iso() {
    local iso_file=$1
    [[ -f "${iso_file}" ]] || die "ISO file not found: ${iso_file}"
    check_iso_file_name "${iso_file}"
    is_iso9660_file "${iso_file}" || die "not an ISO9660 image: ${iso_file}"
    get_iso_path_on_device "${iso_file}" >/dev/null || \
        die "ISO file cannot be accessed at boot time"
}

install_grub_generator() {
    local iso_file=$1
    local action=Installed
    local generator_tmp
    require_root
    check_iso "${iso_file}"
    [[ -d "${grub_generator%/*}" ]] || \
        die "${grub_generator%/*} does not exist, is grub2 installed?"
    [[ -e "${grub_generator}" ]] && action=Updated
    # write to a temporary file first, the script could be
    # called as the installed generator itself
    generator_tmp=$(mktemp "${grub_generator}.XXXXXX") || \
        die "failed to create temporary file"
    # grub2-mkconfig calls the generator without arguments, let the
    # installed copy call main with the ISO given on the command line
    if ! sed -e "s|^main .*|main --kiwi-install-iso '${iso_file}' --grub-menu-entry|" \
        "${BASH_SOURCE[0]}" > "${generator_tmp}" || \
        ! grep -q "^main --kiwi-install-iso '${iso_file}' --grub-menu-entry$" \
        "${generator_tmp}"
    then
        rm -f "${generator_tmp}"
        die "failed to create ${grub_generator}"
    fi
    chmod 0755 "${generator_tmp}"
    mv -f "${generator_tmp}" "${grub_generator}" || {
        rm -f "${generator_tmp}"
        die "failed to install ${grub_generator}"
    }
    echo "${action} ${grub_generator} for ISO ${iso_file}"
    echo
    echo "NOTE: Call grub2-mkconfig to make the change effective, e.g."
    echo "    grub2-mkconfig -o /boot/grub2/grub.cfg"
}

extract_kernel_and_initrd() {
    # extract kernel and initrd from the ISO file into the given directory
    local iso_file=$1
    local target_dir=$2
    local output
    local file
    if command -v xorriso &>/dev/null; then
        if ! output=$(
            xorriso -osirrox on -indev "${iso_file}" \
                -extract "${iso_kernel}" "${target_dir}/linux" \
                -extract "${iso_initrd}" "${target_dir}/initrd" 2>&1
        ); then
            echo "${output}" >&2
            die "failed to extract kernel and initrd from ${iso_file}"
        fi
    else
        mkdir -p "${target_dir}/iso"
        mount -o loop,ro "${iso_file}" "${target_dir}/iso" || \
            die "failed to loop mount ${iso_file}"
        for file in "${iso_kernel}" "${iso_initrd}"; do
            [[ -f "${target_dir}/iso${file}" ]] || \
                die "${file} not found in ${iso_file}"
        done
        if ! cp "${target_dir}/iso${iso_kernel}" "${target_dir}/linux" ||
            ! cp "${target_dir}/iso${iso_initrd}" "${target_dir}/initrd"
        then
            die "failed to extract kernel and initrd from ${iso_file}"
        fi
        umount "${target_dir}/iso"
    fi
    if [[ ! -s "${target_dir}/linux" ]] || [[ ! -s "${target_dir}/initrd" ]]; then
        die "kernel or initrd missing in ${iso_file}"
    fi
}

kexec_boot_iso() {
    local iso_file=$1
    local iso_path
    local cmdline
    local option
    local output
    local cmdline_options
    local boot_options
    require_root
    command -v kexec &>/dev/null || \
        die "kexec not found, please install kexec-tools"
    check_iso "${iso_file}"
    iso_path=$(get_iso_path_on_device "${iso_file}") || exit 1

    tmp_dir=$(mktemp -d /tmp/os-install.XXXXXX) || \
        die "failed to create temporary directory"
    trap cleanup EXIT

    echo "Extracting kernel and initrd from ${iso_file}"
    extract_kernel_and_initrd "${iso_file}" "${tmp_dir}"

    boot_options=$(get_install_boot_options "${iso_file}")
    cmdline="iso-scan/filename=${iso_path} ${boot_options}"
    # keep console setup of the running system
    read -r -a cmdline_options < /proc/cmdline
    for option in "${cmdline_options[@]}"; do
        case "${option}" in
            console=*) cmdline="${cmdline} ${option}" ;;
            *) ;;
        esac
    done

    echo "Loading install kernel with: ${cmdline}"
    # prefer kexec_file_load (-s) which works with secure boot/lockdown
    if ! output=$(
        kexec -s -l "${tmp_dir}/linux" \
            --initrd="${tmp_dir}/initrd" --command-line="${cmdline}" 2>&1
    ); then
        if ! kexec -l "${tmp_dir}/linux" \
            --initrd="${tmp_dir}/initrd" --command-line="${cmdline}"
        then
            echo "${output}" >&2
            die "failed to load install kernel via kexec"
        fi
    fi
    # kernel and initrd are loaded into memory now
    cleanup

    echo "Booting into ${iso_file} via kexec"
    if [[ -d /run/systemd/system ]] && command -v systemctl &>/dev/null; then
        # clean shutdown of services and filesystems before the kexec.
        # systemd uses the already loaded kernel. The call only queues
        # the shutdown job and returns, the system is going down now
        if systemctl kexec; then
            exit 0
        fi
    else
        sync
        kexec -e
    fi
    # only reached if the kexec failed
    kexec -u &>/dev/null
    die "kexec into install kernel failed"
}

grub_generator_menu_entry() {
    local install_iso_file=$1
    local distributor
    local device_access
    local line
    # Source grub config library, provides grub_probe and the
    # grub_* / prepare_grub_to_access_device helper functions
    # shellcheck source=/dev/null
    . /usr/share/grub2/grub-mkconfig_lib

    CLASS="--class memtest86 --class gnu --class tools"

    if [[ -z "${GRUB_DISTRIBUTOR}" ]] ; then
        OS=Installation
    else
        OS="${GRUB_DISTRIBUTOR} Installation"
        # first word of the distributor name in lower case
        distributor="${GRUB_DISTRIBUTOR,,}"
        CLASS="--class ${distributor%% *} ${CLASS}"
    fi

    if ! grub_file_is_not_garbage "${install_iso_file}"; then
        warn "install ISO ${install_iso_file} not found, no menu entry created"
        return 0
    fi
    if ! is_iso9660_file "${install_iso_file}"; then
        warn "${install_iso_file} is not an ISO9660 image, no menu entry created"
        return 0
    fi
    if ! iso_path=$(get_iso_path_on_device "${install_iso_file}"); then
        warn "no menu entry created for ${install_iso_file}"
        return 0
    fi

    iso_device="$("${grub_probe:?}" --target=device "${install_iso_file}")"
    if [[ -z "${iso_device}" ]]; then
        warn "failed to find device of ${install_iso_file}, no menu entry created"
        return 0
    fi

    boot_options=$(get_install_boot_options "${install_iso_file}")

    kernel="(loop)${iso_kernel}"
    initrd="(loop)${iso_initrd}"
    boot_device_id="$(grub_get_device_id "${iso_device}")"
    printf "menuentry '%s' %s \${menuentry_id_option} '%s' {\n" \
        "${OS}" "${CLASS}" "Installation-${boot_device_id}"
    if btrfs subvolume show /boot/grub2/x86_64-efi &>/dev/null;then
        printf "    btrfs-mount-subvol / /boot/grub2/x86_64-efi %s\n" \
            "/@/boot/grub2/x86_64-efi"
    fi
    printf "    insmod loopback\n"
    # iso_device can list multiple devices separated by newline,
    # word splitting is wanted here, same as in /etc/grub.d/10_linux
    # shellcheck disable=SC2086
    if ! device_access=$(prepare_grub_to_access_device ${iso_device}); then
        warn "failed to setup device access for ${install_iso_file}"
    fi
    while IFS= read -r line; do
        printf "    %s\n" "${line}"
    done <<< "${device_access}"
    printf "    set isofile='%s'\n" "${iso_path}"
    printf "    set linux=linux\n"
    printf "    set initrd=initrd\n"
    if [[ "${ARCH}" = "x86_64" ]]; then
       printf "    if [ \"\${grub_platform}\" = \"efi\" ]; then\n"
       printf "        set linux=linuxefi\n"
       printf "        set initrd=initrdefi\n"
       printf "    fi\n"
    fi
    printf "    loopback loop (\$root)\$isofile\n"
    printf "    \$linux %s iso-scan/filename=\$isofile %s\n" \
        "${kernel}" "${boot_options}"
    printf "    \$initrd %s\n" \
        "${initrd}"
    printf "}\n"

    printf "set default='%s'\n" "${OS}"
    printf "set timeout=10\n"
}

main() {
    local iso_file=
    local iso_real_path
    local mode=install

    if [[ $# -eq 0 ]]; then
        usage >&2
        exit 1
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --kiwi-install-iso)
                [[ -n "$2" ]] || die "--kiwi-install-iso requires an ISO file"
                iso_file=$2
                shift 2
            ;;
            --kiwi-install-iso=*)
                iso_file=${1#*=}
                shift
            ;;
            --kexec)
                mode=kexec
                shift
            ;;
            --grub-menu-entry)
                mode=grub-menu-entry
                shift
            ;;
            -h|--help)
                usage
                exit 0
            ;;
            *)
                usage >&2
                die "unknown option: $1"
            ;;
        esac
    done

    [[ -n "${iso_file}" ]] || { usage >&2; die "--kiwi-install-iso is required"; }

    if iso_real_path=$(realpath -e "${iso_file}" 2>/dev/null); then
        iso_file=${iso_real_path}
    elif [[ "${mode}" != "grub-menu-entry" ]]; then
        die "ISO file not found: ${iso_file}"
    fi

    if [[ "${mode}" = "grub-menu-entry" ]]; then
        # called by grub2-mkconfig, a missing ISO must not fail the
        # whole config generation, the function warns and skips it
        grub_generator_menu_entry "${iso_file}"
        exit 0
    fi

    case "${mode}" in
        kexec) kexec_boot_iso "${iso_file}" ;;
        install) install_grub_generator "${iso_file}" ;;
        *) die "unknown mode: ${mode}" ;;
    esac
}

main "$@"
